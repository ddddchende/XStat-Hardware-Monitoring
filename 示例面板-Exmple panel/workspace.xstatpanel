      "canvasBackground": "#0d0d10",
      "canvasShowGrid": true,
      "widgets": [
        {
          "id": "10919d1e-8288-4cde-b890-2121b6b78640",
          "type": "SensorGauge",
          "min": 0,
          "max": 105,
          "color": "#ffffff",
          "sensorId": "cpu//intelcpu/0/temperature/10",
          "showAccent": true,
