        {
          "id": "74e07954-f970-444b-ba1a-b2cb2dd7420c",
          "type": "Custom",
          "customHtml": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n\n<style>\n  * {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  body {\n    background: transparent;\n    overflow: hidden;\n\n    width: 100vw;\n    height: 100vh;\n\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n\n    /* 直接用字体名 —— XStat 自动提取并注入（fontBridge），不要手动加 @font-face */\n    font-family: '方正粗雅宋长简体', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n\n    color: #fff;\n\n    /* 左侧留白 */\n    padding: 0 5rem;\n  }\n\n  .widget {\n    width: 100%;\n\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n\n    min-width: 0;\n  }\n\n  .icon {\n    width: 35rem;\n    height: 35rem;\n\n    fill: #00bfff;\n\n    margin-right: 15rem;\n\n    flex-shrink: 0;\n  }\n\n  .content {\n    display: flex;\n    flex-direction: column;\n\n    justify-content: center;\n    align-items: flex-start;\n\n    min-width: 0;\n  }\n\n  .title {\n    font-size: 32rem;\n    color: #d1e6ff;\n\n    font-weight: 600;\n\n    letter-spacing: 1rem;\n    line-height: 1.2;\n\n    white-space: nowrap;\n  }\n\n  .value {\n    font-size: 48rem;\n    font-weight: 800;\n\n    color: #f1f5f9;\n\n    line-height: 1.1;\n\n    white-space: nowrap;\n  }\n</style>\n\n<script>\n  /* ── 可配置属性：右侧属性面板自动生成表单，改后随数据推送注入 ── */\n  window.__xstatConfig = [\n    { key: 'sensor', label: '传感器', type: 'sensor' },\n    { key: 'title',      label: '标题',     type: 'text',    default: '频率' },\n    { key: 'iconColor',  label: '图标颜色', type: 'color',   default: '#00bfff' },\n    { key: 'titleStyle', label: '标题样式', type: 'textstyle' },\n    { key: 'valueStyle', label: '数值样式', type: 'textstyle' },\n    { key: 'showIcon',   label: '显示图标', type: 'boolean', default: true },\n    { key: 'fontScale',  label: '字号比例', type: 'slider',  min: 0.5, max: 1.5, step: 0.05, default: 1 }\n  ];\n</script>\n\n</head>\n\n<body>\n\n  <div class=\"widget\">\n\n    <!-- 时钟图标 -->\n    <svg\n      id=\"icon\"\n      class=\"icon\"\n      viewBox=\"0 0 24 24\"\n      aria-hidden=\"true\"\n    >\n      <path d=\"M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z\"/>\n    </svg>\n\n    <div class=\"content\">\n      <div class=\"title\" id=\"title\">频率</div>\n      <div\n        class=\"value\"\n        id=\"value\"\n      >\n        -- MHz\n      </div>\n    </div>\n\n  </div>\n\n<script>\n/* 根据控件高度自动缩放（×可配置字号比例） */\nvar curScale = 1;\n\nfunction fitContent() {\n  var h = window.innerHeight;\n  document.documentElement.style.fontSize = (h / 100) * curScale + 'px';\n}\n\nwindow.addEventListener('resize', fitContent);\n\nfitContent();\n\n\n\n/* 查找 CPU 频率传感器 */\nfunction findClockSensor(sensors) {\n\n  /*\n    第一优先级：\n    CPU 分类中的 Clock 类型\n\n    如果有多个 CPU Core，\n    通常会匹配第一个汇总频率。\n  */\n  var sensor = sensors.find(function (s) {\n    var name = String(s.name || '').toLowerCase();\n    return (\n      s.category === 'CPU' &&\n      s.type === 'Clock' &&\n      (\n        name === 'cpu core' ||\n        name === 'cpu package' ||\n        name === 'core clock'\n      ) &&\n      s.value != null\n    );\n  });\n\n  if (sensor) {\n    return sensor;\n  }\n\n  /*\n    第二优先级：\n    任意 CPU Clock\n  */\n  sensor = sensors.find(function (s) {\n    return (\n      s.category === 'CPU' &&\n      s.type === 'Clock' &&\n      s.value != null\n    );\n  });\n\n  if (sensor) {\n    return sensor;\n  }\n\n  /*\n    第三优先级：\n    按常见名称匹配\n  */\n  sensor = sensors.find(function (s) {\n    var name = String(s.name || '').toLowerCase();\n    return (\n      s.type === 'Clock' &&\n      (\n        name === 'cpu core' ||\n        name === 'bus speed' ||\n        name === 'core clock'\n      ) &&\n      s.value != null\n    );\n  });\n\n  return sensor || null;\n}\n\n\n\n/* 接收 XStat 传感器数据 + 可配置属性 */\n  /* ── textstyle helper: apply a textstyle object to an element (color/size/bold/italic/font/shadow) ── */\n  function xstatParseColor(c) {\n    c = String(c || '#000000').trim();\n    var m = c.match(/^#([0-9a-fA-F]{6})$/);\n    if (m) return [parseInt(m[1].slice(0, 2), 16), parseInt(m[1].slice(2, 4), 16), parseInt(m[1].slice(4, 6), 16)];\n    m = c.match(/^#([0-9a-fA-F]{3})$/);\n    if (m) return [parseInt(m[1][0] + m[1][0], 16), parseInt(m[1][1] + m[1][1], 16), parseInt(m[1][2] + m[1][2], 16)];\n    m = c.match(/rgba?\\(([^)]+)\\)/);\n    if (m) { var p = m[1].split(',').map(function (x) { return parseFloat(x.trim()) || 0 }); return [p[0], p[1], p[2]]; }\n    return [0, 0, 0];\n  }\n  function xstatShadowCss(s) {\n    if (!s || !s.enabled) return '';\n    var a = (s.angle != null ? s.angle : 45) * Math.PI / 180;\n    var d = s.distance != null ? s.distance : 4;\n    var o = (s.opacity != null ? s.opacity : 100) / 100;\n    var b = s.blur != null ? s.blur : 8;\n    var rgb = xstatParseColor(s.color);\n    return (Math.cos(a) * d).toFixed(1) + 'px ' + (Math.sin(a) * d).toFixed(1) + 'px ' + b + 'px rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',' + o + ')';\n  }\n  function xstatApplyText(el, s) {\n    if (!el || !s) return;\n    if (s.color) el.style.color = s.color;\n    if (s.fontSize != null) el.style.fontSize = s.fontSize + 'px';\n    if (s.bold != null) el.style.fontWeight = s.bold ? 'bold' : 'normal';\n    if (s.italic != null) el.style.fontStyle = s.italic ? 'italic' : 'normal';\n    if (s.fontFamily) el.style.fontFamily = s.fontFamily;\n    el.style.textShadow = xstatShadowCss(s.textShadow);\n  }\n  window.addEventListener('message', function (event) {\n\n  var data  = event.data || {};\n  var props = data.props || {};\n\n  /* 应用可配置属性 */\n  document.getElementById('title').textContent = props.title != null ? props.title : '频率';\n  document.getElementById('icon').style.fill     = props.iconColor  || '#00bfff';\n  xstatApplyText(document.getElementById('title'), props.titleStyle);\n  xstatApplyText(document.getElementById('value'), props.valueStyle);\n  document.getElementById('icon').style.display  = props.showIcon === false ? 'none' : '';\n  curScale = props.fontScale != null ? Number(props.fontScale) : 1;\n  fitContent();\n\n  var sensors = data.sensors;\n  if (!Array.isArray(sensors)) {\n    return;\n  }\n\n  var sensor = null;\n    if (props.sensor) {\n      sensor = sensors.find(function (s) { return s.id === props.sensor; });\n    }\n    if (!sensor) sensor = findClockSensor(sensors);\n  var valueElement = document.getElementById('value');\n\n  if (sensor && sensor.value != null && Number.isFinite(Number(sensor.value))) {\n    var freq = Number(sensor.value);\n\n    /*\n      自动单位转换\n\n      >= 1000 MHz\n      显示 GHz\n\n      < 1000 MHz\n      显示 MHz\n    */\n    if (freq >= 1000) {\n      valueElement.textContent = (freq / 1000).toFixed(2) + ' GHz';\n    } else {\n      valueElement.textContent = freq.toFixed(0) + ' MHz';\n    }\n  } else {\n    valueElement.textContent = '-- MHz';\n  }\n});\n\n</script>\n\n</body>\n</html>\n",
