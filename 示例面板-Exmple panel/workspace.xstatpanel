        {
          "id": "a877ad49-fae1-43c4-9f17-1c30d4aa90fa",
          "type": "Custom",
          "customHtml": "<!DOCTYPE html>\n<html>\n<head>\n\n<meta charset=\"UTF-8\">\n\n<style>\n\n  * {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  body {\n    background: transparent;\n    overflow: hidden;\n\n    width: 100vw;\n    height: 100vh;\n\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n\n    /* 直接用字体名 —— XStat 自动提取并注入（fontBridge），不要手动加 @font-face */\n    font-family: '方正粗雅宋长简体', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n\n    color: #fff;\n\n    padding: 0 5rem;\n  }\n\n  .widget {\n    width: 100%;\n\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n\n    min-width: 0;\n  }\n\n  .icon {\n    width: 35rem;\n    height: 35rem;\n\n    /* GPU 系列保持绿色 */\n    fill: #4CAF50;\n\n    margin-right: 15rem;\n\n    flex-shrink: 0;\n  }\n\n  .content {\n    display: flex;\n    flex-direction: column;\n\n    justify-content: center;\n    align-items: flex-start;\n\n    min-width: 0;\n  }\n\n  .title {\n    font-size: 32rem;\n\n    color: #d1e6ff;\n\n    font-weight: 600;\n    letter-spacing: 1rem;\n    line-height: 1.2;\n\n    white-space: nowrap;\n  }\n\n  .value {\n    font-size: 48rem;\n\n    font-weight: 800;\n\n    color: #f1f5f9;\n\n    line-height: 1.1;\n\n    white-space: nowrap;\n  }\n\n</style>\n\n<script>\n  /* ── 可配置属性：右侧属性面板自动生成表单，改后随数据推送注入 ── */\n  window.__xstatConfig = [\n    { key: 'sensor', label: '传感器', type: 'sensor' },\n    { key: 'title',      label: '标题',     type: 'text',    default: '显存' },\n    { key: 'iconColor',  label: '图标颜色', type: 'color',   default: '#4CAF50' },\n    { key: 'titleStyle', label: '标题样式', type: 'textstyle' },\n    { key: 'valueStyle', label: '数值样式', type: 'textstyle' },\n    { key: 'showIcon',   label: '显示图标', type: 'boolean', default: true },\n    { key: 'fontScale',  label: '字号比例', type: 'slider',  min: 0.5, max: 1.5, step: 0.05, default: 1 }\n  ];\n</script>\n\n</head>\n\n<body>\n\n<div class=\"widget\">\n\n  <!-- 显存 / Memory 图标 -->\n  <svg\n    id=\"icon\"\n    class=\"icon\"\n    viewBox=\"0 0 24 24\"\n    aria-hidden=\"true\"\n  >\n    <path d=\"\n      M4 6\n      C2.9 6 2 6.9 2 8\n      V16\n      C2 17.1 2.9 18 4 18\n      H20\n      C21.1 18 22 17.1 22 16\n      V8\n      C22 6.9 21.1 6 20 6\n      H4\n      Z\n\n      M5 9\n      H7\n      V15\n      H5\n      V9\n      Z\n\n      M9 9\n      H11\n      V15\n      H9\n      V9\n      Z\n\n      M13 9\n      H15\n      V15\n      H13\n      V9\n      Z\n\n      M17 9\n      H19\n      V15\n      H17\n      V9\n      Z\n    \"/>\n</svg>\n\n<div class=\"content\">\n\n  <div class=\"title\" id=\"title\">\n    显存\n  </div>\n\n  <div\n    class=\"value\"\n    id=\"value\"\n  >\n    -- GB / -- GB\n  </div>\n\n</div>\n\n</div>\n\n<script>\n/* 根据控件高度自动缩放（×可配置字号比例） */\nvar curScale = 1;\n\nfunction fitContent() {\n  var h = window.innerHeight;\n  document.documentElement.style.fontSize = (h / 100) * curScale + 'px';\n}\n\nwindow.addEventListener('resize', fitContent);\n\nfitContent();\n\n/* 查找显存传感器（GPU 优先，避免撞上 RAM 的 \"Memory Used\"） */\nfunction findMemorySensor(sensors, type) {\n\n  var keywords;\n\n  if (type === 'used') {\n    keywords = [\n      'gpu memory used',\n      'memory used',\n      'gpu memory usage'\n    ];\n  } else {\n    keywords = [\n      'gpu memory total',\n      'memory total',\n      'gpu memory size'\n    ];\n  }\n\n  /* 第一优先级：GPU 分类下精确匹配 */\n  var sensor = sensors.find(function (s) {\n    var name = String(s.name || '').toLowerCase();\n    return (\n      s.category === 'GPU' &&\n      s.value != null &&\n      keywords.some(function (keyword) {\n        return name === keyword;\n      })\n    );\n  });\n\n  if (sensor) {\n    return sensor;\n  }\n\n  /* 兜底：任意分类 */\n  sensor = sensors.find(function (s) {\n    var name = String(s.name || '').toLowerCase();\n    return (\n      s.value != null &&\n      keywords.some(function (keyword) {\n        return name === keyword;\n      })\n    );\n  });\n\n  return sensor || null;\n}\n\n/* 接收 XStat 传感器数据 + 可配置属性 */\n  /* ── textstyle helper: apply a textstyle object to an element (color/size/bold/italic/font/shadow) ── */\n  function xstatParseColor(c) {\n    c = String(c || '#000000').trim();\n    var m = c.match(/^#([0-9a-fA-F]{6})$/);\n    if (m) return [parseInt(m[1].slice(0, 2), 16), parseInt(m[1].slice(2, 4), 16), parseInt(m[1].slice(4, 6), 16)];\n    m = c.match(/^#([0-9a-fA-F]{3})$/);\n    if (m) return [parseInt(m[1][0] + m[1][0], 16), parseInt(m[1][1] + m[1][1], 16), parseInt(m[1][2] + m[1][2], 16)];\n    m = c.match(/rgba?\\(([^)]+)\\)/);\n    if (m) { var p = m[1].split(',').map(function (x) { return parseFloat(x.trim()) || 0 }); return [p[0], p[1], p[2]]; }\n    return [0, 0, 0];\n  }\n  function xstatShadowCss(s) {\n    if (!s || !s.enabled) return '';\n    var a = (s.angle != null ? s.angle : 45) * Math.PI / 180;\n    var d = s.distance != null ? s.distance : 4;\n    var o = (s.opacity != null ? s.opacity : 100) / 100;\n    var b = s.blur != null ? s.blur : 8;\n    var rgb = xstatParseColor(s.color);\n    return (Math.cos(a) * d).toFixed(1) + 'px ' + (Math.sin(a) * d).toFixed(1) + 'px ' + b + 'px rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',' + o + ')';\n  }\n  function xstatApplyText(el, s) {\n    if (!el || !s) return;\n    if (s.color) el.style.color = s.color;\n    if (s.fontSize != null) el.style.fontSize = s.fontSize + 'px';\n    if (s.bold != null) el.style.fontWeight = s.bold ? 'bold' : 'normal';\n    if (s.italic != null) el.style.fontStyle = s.italic ? 'italic' : 'normal';\n    if (s.fontFamily) el.style.fontFamily = s.fontFamily;\n    el.style.textShadow = xstatShadowCss(s.textShadow);\n  }\n  window.addEventListener('message', function (event) {\n\n  var data  = event.data || {};\n  var props = data.props || {};\n\n  /* 应用可配置属性 */\n  document.getElementById('title').textContent = props.title != null ? props.title : '显存';\n  document.getElementById('icon').style.fill     = props.iconColor  || '#4CAF50';\n  xstatApplyText(document.getElementById('title'), props.titleStyle);\n  xstatApplyText(document.getElementById('value'), props.valueStyle);\n  document.getElementById('icon').style.display  = props.showIcon === false ? 'none' : '';\n  curScale = props.fontScale != null ? Number(props.fontScale) : 1;\n  fitContent();\n\n  var sensors = data.sensors;\n  if (!Array.isArray(sensors)) {\n    return;\n  }\n\n  /* 属性面板绑定了传感器：直接显示其原始值（GB） */\n  if (props.sensor) {\n    var bound = sensors.find(function (s) { return s.id === props.sensor; });\n    if (bound && bound.value != null) {\n      document.getElementById('value').textContent = (Number(bound.value) / 1024).toFixed(1) + ' GB';\n      return;\n    }\n  }\n\n  var usedSensor = findMemorySensor(sensors, 'used');\n  var totalSensor = findMemorySensor(sensors, 'total');\n  var valueElement = document.getElementById('value');\n\n  if (\n    usedSensor &&\n    totalSensor &&\n    Number.isFinite(Number(usedSensor.value)) &&\n    Number.isFinite(Number(totalSensor.value))\n  ) {\n    var usedMB  = Number(usedSensor.value);\n    var totalMB = Number(totalSensor.value);\n    var usedGB  = usedMB / 1024;\n    var totalGB = totalMB / 1024;\n\n    /*\n      显存统一显示 GB\n\n      例如：\n      8.4 GB / 24 GB\n    */\n    valueElement.textContent =\n      usedGB.toFixed(1) +\n      ' GB / ' +\n      totalGB.toFixed(0) +\n      ' GB';\n  } else {\n    valueElement.textContent = '-- GB / -- GB';\n  }\n});\n\n</script>\n\n</body>\n</html>\n",
          "customFiles": {},
          "widgetName": "CPU封装功耗",
          "zIndex": 1
        },
        {
          "id": "fd16c7cd-4f95-40c2-825c-f9cc7f082cf7",
          "type": "SensorBar",
          "min": 0,
          "max": 200,
          "color": "#7c6ef5",
          "variant": "flat",
          "showLabel": false,
          "zIndex": 1,
          "showAccent": true,
          "showValue": false,
          "sensorId": "gpunvidia//gpu-nvidia/0/power/0",
          "accentColor": "#4caf50"
        },
        {
          "id": "d0fe8310-ba58-4623-bc5b-feb34b9cda8f",
          "type": "Custom",
          "customHtml": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n\n<style>\n  * {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  body {\n    background: transparent;\n    overflow: hidden;\n\n    width: 100vw;\n    height: 100vh;\n\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n\n    /* 直接用字体名 —— XStat 自动提取并注入（fontBridge），不要手动加 @font-face */\n    font-family: '方正粗雅宋长简体', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n\n    color: #fff;\n\n    padding: 0 5rem;\n  }\n\n  .widget {\n    width: 100%;\n\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n\n    min-width: 0;\n  }\n\n  .icon {\n    width: 35rem;\n    height: 35rem;\n\n    /* 保持绿色 */\n    fill: #4CAF50;\n\n    margin-right: 15rem;\n\n    flex-shrink: 0;\n  }\n\n  .content {\n    display: flex;\n    flex-direction: column;\n\n    justify-content: center;\n    align-items: flex-start;\n\n    min-width: 0;\n  }\n\n  /* 和前两个控件一致 */\n  .title {\n    font-size: 32rem;\n\n    color: #d1e6ff;\n\n    font-weight: 600;\n    letter-spacing: 1rem;\n    line-height: 1.2;\n\n    white-space: nowrap;\n  }\n\n  /* 和前两个控件一致 */\n  .value {\n    font-size: 48rem;\n\n    font-weight: 800;\n    color: #f1f5f9;\n\n    line-height: 1.1;\n\n    white-space: nowrap;\n  }\n</style>\n\n<script>\n  /* ── 可配置属性：右侧属性面板自动生成表单，改后随数据推送注入 ── */\n  window.__xstatConfig = [\n    { key: 'sensor', label: '传感器', type: 'sensor' },\n    { key: 'title',      label: '标题',       type: 'text',    default: '功耗' },\n    { key: 'unit',       label: '单位后缀',   type: 'text',    default: 'W' },\n    { key: 'decimals',   label: '小数位',     type: 'number',  default: 1, min: 0, max: 3, step: 1 },\n    { key: 'iconColor',  label: '图标颜色',   type: 'color',   default: '#4CAF50' },\n    { key: 'titleStyle', label: '标题样式', type: 'textstyle' },\n    { key: 'valueStyle', label: '数值样式', type: 'textstyle' },\n    { key: 'showIcon',   label: '显示图标',   type: 'boolean', default: true },\n    { key: 'fontScale',  label: '字号比例',   type: 'slider',  min: 0.5, max: 1.5, step: 0.05, default: 1 }\n  ];\n</script>\n\n</head>\n\n<body>\n\n  <div class=\"widget\">\n\n    <!-- GPU 功耗图标 -->\n    <svg\n      id=\"icon\"\n      class=\"icon\"\n      viewBox=\"0 0 24 24\"\n      aria-hidden=\"true\"\n    >\n      <path d=\"M11 15H6l7-14v8h5l-7 14v-8z\"/>\n    </svg>\n\n    <div class=\"content\">\n\n      <div class=\"title\" id=\"title\">\n        功耗\n      </div>\n\n      <div\n        class=\"value\"\n        id=\"value\"\n      >\n        -- W\n      </div>\n\n    </div>\n\n  </div>\n\n<script>\n/* 根据控件高度自动缩放（×可配置字号比例） */\nvar curScale = 1;\n\nfunction fitContent() {\n  var h = window.innerHeight;\n  document.documentElement.style.fontSize = (h / 100) * curScale + 'px';\n}\n\nwindow.addEventListener('resize', fitContent);\n\nfitContent();\n\n\n\nfunction findGpuPowerSensor(sensors) {\n\n  /* 第一优先级：GPU Power */\n  var sensor = sensors.find(function (s) {\n    return (\n      s.category === 'GPU' &&\n      s.type === 'Power' &&\n      s.value != null\n    );\n  });\n\n  if (sensor) {\n    return sensor;\n  }\n\n  /* 第二优先级：按名称匹配 */\n  sensor = sensors.find(function (s) {\n    var name = String(s.name || '').toLowerCase();\n    return (\n      s.type === 'Power' &&\n      (\n        name === 'gpu package' ||\n        name === 'gpu package power' ||\n        name === 'gpu power'\n      ) &&\n      s.value != null\n    );\n  });\n\n  return sensor || null;\n}\n\n\n\n/* 接收 XStat 传感器数据 + 可配置属性 */\n  /* ── textstyle helper: apply a textstyle object to an element (color/size/bold/italic/font/shadow) ── */\n  function xstatParseColor(c) {\n    c = String(c || '#000000').trim();\n    var m = c.match(/^#([0-9a-fA-F]{6})$/);\n    if (m) return [parseInt(m[1].slice(0, 2), 16), parseInt(m[1].slice(2, 4), 16), parseInt(m[1].slice(4, 6), 16)];\n    m = c.match(/^#([0-9a-fA-F]{3})$/);\n    if (m) return [parseInt(m[1][0] + m[1][0], 16), parseInt(m[1][1] + m[1][1], 16), parseInt(m[1][2] + m[1][2], 16)];\n    m = c.match(/rgba?\\(([^)]+)\\)/);\n    if (m) { var p = m[1].split(',').map(function (x) { return parseFloat(x.trim()) || 0 }); return [p[0], p[1], p[2]]; }\n    return [0, 0, 0];\n  }\n  function xstatShadowCss(s) {\n    if (!s || !s.enabled) return '';\n    var a = (s.angle != null ? s.angle : 45) * Math.PI / 180;\n    var d = s.distance != null ? s.distance : 4;\n    var o = (s.opacity != null ? s.opacity : 100) / 100;\n    var b = s.blur != null ? s.blur : 8;\n    var rgb = xstatParseColor(s.color);\n    return (Math.cos(a) * d).toFixed(1) + 'px ' + (Math.sin(a) * d).toFixed(1) + 'px ' + b + 'px rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',' + o + ')';\n  }\n  function xstatApplyText(el, s) {\n    if (!el || !s) return;\n    if (s.color) el.style.color = s.color;\n    if (s.fontSize != null) el.style.fontSize = s.fontSize + 'px';\n    if (s.bold != null) el.style.fontWeight = s.bold ? 'bold' : 'normal';\n    if (s.italic != null) el.style.fontStyle = s.italic ? 'italic' : 'normal';\n    if (s.fontFamily) el.style.fontFamily = s.fontFamily;\n    el.style.textShadow = xstatShadowCss(s.textShadow);\n  }\n  window.addEventListener('message', function (event) {\n\n  var data  = event.data || {};\n  var props = data.props || {};\n\n  /* 应用可配置属性 */\n  var unit = props.unit != null ? props.unit : 'W';\n  var dec  = props.decimals != null ? Number(props.decimals) : 1;\n\n  document.getElementById('title').textContent = props.title != null ? props.title : '功耗';\n  document.getElementById('icon').style.fill     = props.iconColor  || '#4CAF50';\n  xstatApplyText(document.getElementById('title'), props.titleStyle);\n  xstatApplyText(document.getElementById('value'), props.valueStyle);\n  document.getElementById('icon').style.display  = props.showIcon === false ? 'none' : '';\n  curScale = props.fontScale != null ? Number(props.fontScale) : 1;\n  fitContent();\n\n  var sensors = data.sensors;\n  if (!Array.isArray(sensors)) {\n    return;\n  }\n\n  var sensor = null;\n    if (props.sensor) {\n      sensor = sensors.find(function (s) { return s.id === props.sensor; });\n    }\n    if (!sensor) sensor = findGpuPowerSensor(sensors);\n  var valueElement = document.getElementById('value');\n\n  if (sensor && sensor.value != null && Number.isFinite(Number(sensor.value))) {\n    valueElement.textContent = Number(sensor.value).toFixed(dec) + ' ' + unit;\n  } else {\n    valueElement.textContent = '-- ' + unit;\n  }\n});\n\n</script>\n\n</body>\n</html>\n",
