    {
      "id": "87a9f4f8-770b-4c41-a097-c8b61a9a3d1e",
      "type": "Custom",
      "customHtml": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  * { margin: 0; padding: 0; }\n  body {\n    background: transparent;\n    overflow: hidden;\n    height: 100vh;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    /* 直接用字体名 —— XStat 自动提取并注入（fontBridge），不要手动加 @font-face */\n    font-family: 'Unifont', Inter, system-ui, sans-serif;\n    color: #fff;\n  }\n  #label { font-size: 16vmin; color: #c4c4c4; margin-bottom: 1vmin; letter-spacing: 1px; }\n  #value { font-size: 48vmin; font-weight: 700; color: #F07505; line-height: 1; }\n  #unit  { font-size: 48vmin; color: #F07505; font-weight: 700; margin-left: 1vmin; }\n</style>\n<script>\n  /* ── 可配置属性：右侧属性面板自动生成表单，改后随数据推送注入 ── */\n  window.__xstatConfig = [\n    { key: 'sensor', label: '传感器', type: 'sensor' },\n    { key: 'label',       label: '标题',     type: 'text',    default: '使用率' },\n    { key: 'labelStyle', label: '标题样式', type: 'textstyle' },\n    { key: 'unit',        label: '单位',     type: 'text',    default: '%' },\n    { key: 'decimals',    label: '小数位',   type: 'number',  default: 0, min: 0, max: 3, step: 1 },\n    { key: 'valueStyle', label: '数值样式', type: 'textstyle' },\n    { key: 'fontScale',   label: '字号比例', type: 'slider',  min: 0.5, max: 1.5, step: 0.05, default: 1 }\n  ];\n</script>\n</head>\n<body>\n  <div id=\"label\">使用率</div>\n  <div>\n    <span id=\"value\">--</span><span id=\"unit\">%</span>\n  </div>\n  <script>\n    // 同一硬件条目下的传感器（id 前缀相同）才算一组\n    function sameHardware(a, b) {\n      if (a.id && b.id) {\n        var ia = a.id.lastIndexOf('/'), ib = b.id.lastIndexOf('/');\n        if (ia > 0 && ib > 0) return a.id.slice(0, ia) === b.id.slice(0, ib);\n      }\n      return !!(a.hardwareName && b.hardwareName && a.hardwareName === b.hardwareName);\n    }\n\n      /* ── textstyle helper: apply a textstyle object to an element (color/size/bold/italic/font/shadow) ── */\n  function xstatParseColor(c) {\n    c = String(c || '#000000').trim();\n    var m = c.match(/^#([0-9a-fA-F]{6})$/);\n    if (m) return [parseInt(m[1].slice(0, 2), 16), parseInt(m[1].slice(2, 4), 16), parseInt(m[1].slice(4, 6), 16)];\n    m = c.match(/^#([0-9a-fA-F]{3})$/);\n    if (m) return [parseInt(m[1][0] + m[1][0], 16), parseInt(m[1][1] + m[1][1], 16), parseInt(m[1][2] + m[1][2], 16)];\n    m = c.match(/rgba?\\(([^)]+)\\)/);\n    if (m) { var p = m[1].split(',').map(function (x) { return parseFloat(x.trim()) || 0 }); return [p[0], p[1], p[2]]; }\n    return [0, 0, 0];\n  }\n  function xstatShadowCss(s) {\n    if (!s || !s.enabled) return '';\n    var a = (s.angle != null ? s.angle : 45) * Math.PI / 180;\n    var d = s.distance != null ? s.distance : 4;\n    var o = (s.opacity != null ? s.opacity : 100) / 100;\n    var b = s.blur != null ? s.blur : 8;\n    var rgb = xstatParseColor(s.color);\n    return (Math.cos(a) * d).toFixed(1) + 'px ' + (Math.sin(a) * d).toFixed(1) + 'px ' + b + 'px rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',' + o + ')';\n  }\n  function xstatApplyText(el, s) {\n    if (!el || !s) return;\n    if (s.color) el.style.color = s.color;\n    if (s.fontSize != null) el.style.fontSize = s.fontSize + 'px';\n    if (s.bold != null) el.style.fontWeight = s.bold ? 'bold' : 'normal';\n    if (s.italic != null) el.style.fontStyle = s.italic ? 'italic' : 'normal';\n    if (s.fontFamily) el.style.fontFamily = s.fontFamily;\n    el.style.textShadow = xstatShadowCss(s.textShadow);\n  }\n  window.addEventListener('message', function(e) {\n      var data  = e.data || {};\n      var props = data.props || {};\n\n      /* 应用可配置属性 */\n      var label = props.label != null ? props.label : '使用率';\n      var unit  = props.unit  != null ? props.unit  : '%';\n      var dec   = props.decimals != null ? Number(props.decimals) : 0;\n      \n      document.getElementById('label').textContent = label;\n      xstatApplyText(document.getElementById('label'), props.labelStyle);\n      document.getElementById('unit').textContent  = unit;\n      xstatApplyText(document.getElementById('value'), props.valueStyle);\n      xstatApplyText(document.getElementById('unit'), props.valueStyle);\n      document.documentElement.style.zoom = props.fontScale != null ? Number(props.fontScale) : 1;\n\n      var sensors = data.sensors;\n      if (!sensors) return;\n\n      /* 属性面板绑定了传感器：直接显示其原始值 */\n      if (props.sensor) {\n        var bound = sensors.find(function (s) { return s.id === props.sensor; });\n        if (bound && bound.value != null) {\n          document.getElementById('value').textContent = Number(bound.value).toFixed(dec) + ' ' + unit;\n          return;\n        }\n      }\n\n      // LHM 同时暴露\"提交内存(含虚拟内存)\"和\"物理内存\"两组 RAM 传感器，\n      // 提交内存那组 Used+Available 远大于物理内存，必须排除。\n      // 取各组总量(Used+Available)最小的一组 = 物理内存。\n      var best = null;\n      sensors.forEach(function(s) {\n        if (s.category !== 'RAM' || s.type !== 'Data') return;\n        if (s.name !== 'Used Memory' && s.name !== 'Memory Used') return;\n        var avail = sensors.find(function(a) {\n          return a !== s\n            && a.category === 'RAM'\n            && a.type === 'Data'\n            && (a.name === 'Available Memory' || a.name === 'Memory Available')\n            && sameHardware(a, s);\n        });\n        if (!avail || s.value == null || avail.value == null) return;\n        var total = s.value + avail.value;\n        if (!best || total < best.total) best = { used: s.value, total: total };\n      });\n\n      if (!best || best.total <= 0) return;\n      var pct = best.used / best.total * 100;\n      document.getElementById('value').textContent = pct.toFixed(dec);\n    });\n  </script>\n</body>\n</html>\n",
