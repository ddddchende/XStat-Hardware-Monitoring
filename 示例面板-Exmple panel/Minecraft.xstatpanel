    {
      "id": "10395074-cd1b-49e9-b78a-972d4e12358d",
      "type": "Custom",
      "customHtml": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  * {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n    image-rendering: pixelated;\n    -webkit-font-smoothing: none;\n    -moz-osx-font-smoothing: none;\n    font-family: 'Press Start 2P', 'Minecraft', 'Consolas', 'Courier New', monospace;\n  }\n\n  body {\n    background: transparent;\n    overflow: hidden;\n    height: 100vh;\n    width: 100vw;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .xp-scene {\n    position: relative;\n    width: 100vw;\n    height: 100vh;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 1.5vh;\n  }\n\n  .xp-level {\n    font-size: 5vmin;\n    color: #80FF20;\n    text-shadow:\n      0.3vmin 0.3vmin 0 #000000,\n      -0.3vmin 0.3vmin 0 #000000,\n      0.3vmin -0.3vmin 0 #000000,\n      -0.3vmin -0.3vmin 0 #000000,\n      0 0 1.5vmin rgba(128, 255, 32, 0.5);\n    letter-spacing: 0.4vmin;\n    text-align: center;\n    white-space: nowrap;\n    overflow: hidden;\n    max-width: 90vw;\n    text-overflow: ellipsis;\n    transition: font-size 0.2s, color 0.2s;\n  }\n\n  .xp-bar-wrapper {\n    position: relative;\n    width: 60vw;\n    height: 4.5vh;\n    min-width: 30vw;\n    min-height: 2vh;\n  }\n\n  .xp-track {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    background-color: #1a1a1a;\n    border: 0.4vmin solid #000000;\n    box-shadow:\n      0 0 0 0.3vmin rgba(255, 255, 255, 0.1),\n      inset 0 0.3vmin 0 rgba(255, 255, 255, 0.05),\n      inset 0 -0.3vmin 0 rgba(0, 0, 0, 0.5);\n  }\n\n  .xp-track-bg {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: fill;\n    pointer-events: none;\n  }\n\n  .xp-fill-wrapper {\n    position: absolute;\n    top: 0;\n    left: 0;\n    height: 100%;\n    width: 0%;\n    overflow: hidden;\n    z-index: 1;\n    transition: width 0.2s ease-out;\n  }\n\n  .xp-fill-img {\n    position: absolute;\n    top: 0;\n    left: 0;\n    height: 100%;\n    width: 100%;\n    object-fit: fill;\n    pointer-events: none;\n  }\n\n  .xp-fill-wrapper.animating .xp-fill-img {\n    animation: xpBlink 0.1s steps(2) infinite;\n  }\n  @keyframes xpBlink {\n    0% { filter: brightness(1); }\n    50% { filter: brightness(1.4); }\n    100% { filter: brightness(1); }\n  }\n\n  .xp-value {\n    font-size: 3vmin;\n    color: #C8FF80;\n    text-shadow:\n      0.2vmin 0.2vmin 0 #000000,\n      -0.2vmin 0.2vmin 0 #000000;\n    text-align: center;\n    white-space: nowrap;\n    opacity: 0.8;\n  }\n</style>\n</head>\n<body>\n<div class=\"xp-scene\" id=\"scene\">\n  <div class=\"xp-level\" id=\"level\">Level 0</div>\n  <div class=\"xp-bar-wrapper\" id=\"barWrapper\">\n    <div class=\"xp-track\" id=\"track\">\n      <img class=\"xp-track-bg\" id=\"trackBg\" src=\"\" alt=\"\">\n      <div class=\"xp-fill-wrapper\" id=\"fillWrapper\">\n        <img class=\"xp-fill-img\" id=\"fillImg\" src=\"\" alt=\"\">\n      </div>\n    </div>\n  </div>\n  <div class=\"xp-value\" id=\"value\">0 / 100</div>\n</div>\n\n<script>\n  /* ========== XStat 可配置属性声明 ========== */\n  window.__xstatConfig = [\n    { key: 'sensor',         label: '进度条传感器',   type: 'sensor',  default: '' },\n    { key: 'max',            label: '最大值',         type: 'number',  default: 100, min: 1, max: 100000, step: 1 },\n    { key: 'speed',          label: '模拟速度',       type: 'slider',  min: 1, max: 200, step: 1, default: 30 },\n    { key: 'levelSensor',    label: '等级传感器',     type: 'sensor',  default: '' },\n    { key: 'level',          label: '等级 (手动)',    type: 'number',  default: 0, min: 0, max: 10000, step: 1 },\n    { key: 'levelPrefix',    label: '等级前缀',       type: 'text',    default: 'Level ' },\n    { key: 'levelUnit',      label: '等级后缀',       type: 'text',    default: '' },\n    { key: 'levelDecimals',  label: '等级小数位',     type: 'number',  default: 0, min: 0, max: 3, step: 1 },\n    { key: 'showLevel',      label: '显示等级文本',   type: 'boolean', default: true },\n    { key: 'levelFontSize',  label: '等级字号 (vmin)', type: 'slider', min: 2, max: 15, step: 0.5, default: 5 },\n    { key: 'levelColor',     label: '等级颜色',       type: 'color',   default: '#80FF20' },\n    { key: 'showValue',      label: '显示底部数值',   type: 'boolean', default: true },\n    { key: 'widthVW',        label: '条宽度 (vw)',    type: 'slider',  min: 20, max: 100, step: 1, default: 60 },\n    { key: 'heightVH',       label: '条高度 (vh)',    type: 'slider',  min: 1, max: 15, step: 0.5, default: 4.5 }\n  ];\n\n  /* ========== 内嵌图片 base64 数据 ========== */\n  // 暗色背景（Blue_Notched_20Background.png）\n  var BG_BASE64 = \"data:image/png;base64,\";\n  // 亮色填充（Blue_Notched_20Progress.png）\n  var FILL_BASE64 = \"data:image/png;base64,\";\n\n  /* 设置图片 src */\n  document.getElementById('trackBg').src = BG_BASE64;\n  document.getElementById('fillImg').src = FILL_BASE64;\n\n  /* ========== 状态 ========== */\n  var simValue = 0;\n  var simSpeed = 30;\n  var maxVal = 100;\n  var manualLevel = 0;\n  var currentMode = 'sim';\n  var animId = null;\n  var lastTimestamp = null;\n\n  /* ========== 辅助函数 ========== */\n  function clamp(v, min, max) {\n    return Math.max(min, Math.min(max, v));\n  }\n\n  function updateBar(value) {\n    var fillWrapper = document.getElementById('fillWrapper');\n    var track = document.getElementById('track');\n    var fillImg = document.getElementById('fillImg');\n    var pct = clamp((value / maxVal) * 100, 0, 100);\n    fillWrapper.style.width = pct + '%';\n    fillImg.style.width = track.offsetWidth + 'px';\n  }\n\n  function updateValueDisplay(value) {\n    var el = document.getElementById('value');\n    el.textContent = Math.floor(value) + ' / ' + maxVal;\n  }\n\n  function updateLevelText(text) {\n    document.getElementById('level').textContent = text;\n  }\n\n  function applyLevelStyle(show, fontSize, color) {\n    var levelEl = document.getElementById('level');\n    levelEl.style.display = show ? '' : 'none';\n    levelEl.style.fontSize = fontSize + 'vmin';\n    levelEl.style.color = color;\n  }\n\n  /* ========== 模拟循环 ========== */\n  function startSim() {\n    if (animId !== null) return;\n    lastTimestamp = null;\n\n    function step(ts) {\n      if (currentMode !== 'sim') {\n        animId = null;\n        return;\n      }\n      if (lastTimestamp === null) lastTimestamp = ts;\n      var delta = (ts - lastTimestamp) / 1000;\n      lastTimestamp = ts;\n\n      simValue += simSpeed * delta;\n      if (simValue >= maxVal) {\n        manualLevel++;\n        simValue = 0;\n        updateLevelText('Level ' + manualLevel);\n      }\n\n      updateBar(simValue);\n      updateValueDisplay(simValue);\n\n      var fillWrapper = document.getElementById('fillWrapper');\n      if (simSpeed > 0 && !fillWrapper.classList.contains('animating')) {\n        fillWrapper.classList.add('animating');\n      }\n\n      animId = requestAnimationFrame(step);\n    }\n\n    animId = requestAnimationFrame(step);\n  }\n\n  function stopSim() {\n    if (animId !== null) {\n      cancelAnimationFrame(animId);\n      animId = null;\n      lastTimestamp = null;\n    }\n    document.getElementById('fillWrapper').classList.remove('animating');\n  }\n\n  /* ========== 窗口尺寸变化 ========== */\n  function onResize() {\n    var track = document.getElementById('track');\n    var fillImg = document.getElementById('fillImg');\n    if (track && fillImg) {\n      fillImg.style.width = track.offsetWidth + 'px';\n    }\n  }\n\n  window.addEventListener('resize', onResize);\n  if (window.ResizeObserver) {\n    var trackEl = document.getElementById('track');\n    if (trackEl) {\n      var ro = new ResizeObserver(function() {\n        onResize();\n      });\n      ro.observe(trackEl);\n    }\n  }\n\n  /* ========== 监听 XStat 消息 ========== */\n  window.addEventListener('message', function(e) {\n    var data = e.data || {};\n    var props = data.props || {};\n    var sensors = data.sensors || [];\n\n    if (props.max != null) maxVal = Math.max(1, Number(props.max));\n    if (props.speed != null) simSpeed = Number(props.speed);\n    if (props.level != null) manualLevel = Number(props.level);\n\n    var wrapper = document.getElementById('barWrapper');\n    if (props.widthVW != null) wrapper.style.width = Number(props.widthVW) + 'vw';\n    if (props.heightVH != null) wrapper.style.height = Number(props.heightVH) + 'vh';\n\n    var showValue = props.showValue !== false;\n    document.getElementById('value').style.display = showValue ? '' : 'none';\n\n    var showLevel = props.showLevel !== false;\n    var levelFontSize = props.levelFontSize != null ? Number(props.levelFontSize) : 5;\n    var levelColor = props.levelColor || '#80FF20';\n    applyLevelStyle(showLevel, levelFontSize, levelColor);\n\n    var levelPrefix = props.levelPrefix != null ? props.levelPrefix : 'Level ';\n    var levelUnit = props.levelUnit != null ? props.levelUnit : '';\n    var levelDecimals = props.levelDecimals != null ? Number(props.levelDecimals) : 0;\n\n    if (props.levelSensor) {\n      var levelTarget = sensors.find(function(s) { return s.id === props.levelSensor; });\n      if (levelTarget && levelTarget.value != null) {\n        var lv = Number(levelTarget.value);\n        updateLevelText(levelPrefix + lv.toFixed(levelDecimals) + levelUnit);\n      } else {\n        updateLevelText(levelPrefix + manualLevel.toFixed(levelDecimals) + levelUnit);\n      }\n    } else {\n      updateLevelText(levelPrefix + manualLevel.toFixed(levelDecimals) + levelUnit);\n    }\n\n    if (props.sensor) {\n      currentMode = 'sensor';\n      stopSim();\n\n      var barTarget = sensors.find(function(s) { return s.id === props.sensor; });\n      if (barTarget && barTarget.value != null) {\n        var v = Number(barTarget.value);\n        updateBar(v);\n        updateValueDisplay(v);\n        document.getElementById('fillWrapper').classList.remove('animating');\n      } else {\n        document.getElementById('fillWrapper').style.width = '0%';\n        document.getElementById('value').textContent = '--';\n      }\n    } else {\n      currentMode = 'sim';\n      if (animId === null) {\n        startSim();\n      }\n    }\n\n    onResize();\n  });\n\n  /* ========== 初始化 ========== */\n  applyLevelStyle(true, 5, '#80FF20');\n  updateLevelText('Level 0');\n  updateBar(0);\n  updateValueDisplay(0);\n  currentMode = 'sim';\n  startSim();\n  onResize();\n</script>\n</body>\n</html>",
