<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: current configuration + clear-config action -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_config_label"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/configSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnClear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_clear"
        android:backgroundTint="@color/bg_surface"
        android:textColor="@color/text" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_back"
        android:backgroundTint="@color/purple"
        android:textColor="@color/text"
        android:layout_marginTop="16dp" />

</LinearLayout>
